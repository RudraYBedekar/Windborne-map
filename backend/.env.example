# WindBorne API Configuration
WB_API_KEY=your_windborne_api_key
WINDBORNE_BASE_URL=https://api.windbornesystems.com

# ----------------------------------------------------
# AI Model Configuration (Vicky-AI)
# ----------------------------------------------------
AWS_REGION=us-east-1

# Options for BEDROCK_MODEL_ID:
# 1. NVIDIA Nemotron: nvidia/nemotron-nano-3-30b or nvidia.nemotron-4-340b-instruct
# 2. Anthropic Claude: anthropic.claude-3-5-sonnet-20240620-v1:0 or anthropic.claude-3-haiku-20240307-v1:0
# 3. Amazon Nova: amazon.nova-micro-v1:0
BEDROCK_MODEL_ID=nvidia/nemotron-nano-3-30b

# Optional: If self-hosting NVIDIA NIM on EC2 GPU (e.g. g5.2xlarge):
# NVIDIA_NIM_URL=http://127.0.0.1:8000
# NVIDIA_API_KEY=

# If running on EC2 with IAM Instance Profile, leave AWS keys empty.
# If running locally with explicit IAM User credentials, provide:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Server CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
