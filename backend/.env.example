# WindBorne API
WB_API_KEY=your_windborne_api_key
WINDBORNE_BASE_URL=https://api.windbornesystems.com

# ----------------------------------------------------
# Vicky-AI — Amazon Bedrock (single source of truth)
# ----------------------------------------------------
BEDROCK_ENABLED=true
AWS_REGION=us-east-1

# Prefer these (matches production .env). Do NOT use NVIDIA / Nemotron IDs.
BEDROCK_AGENT_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_LLM_MODEL=us.amazon.nova-2-lite-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# Optional branding overrides (otherwise derived from model ID)
AI_PROVIDER=Amazon Bedrock
# AI_MODEL_DISPLAY_NAME=Claude Haiku 4.5

# OpenWeatherMap tile overlays (Clouds / Temp / Wind) — proxied & rate-limited
OPENWEATHER_KEY=your_openweather_api_key
# App plan is often 60 RPM; keep a safety margin
OPENWEATHER_RPM_LIMIT=50

# Balloon markers on the website (default off — Treasure feed not operationally accurate)
BALLOONS_ENABLED=false

# WeatherMesh tropical cyclones + gridded forecast layers
CYCLONES_ENABLED=true
GRIDDED_FORECASTS_ENABLED=true
WEATHERMESH_MODEL=wm-6
# Free trial: space upstream WindBorne fetches ≥ 5 minutes apart
WB_MIN_REQUEST_INTERVAL_SEC=300

# AWS credentials (leave empty on EC2 IAM role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CHAT_RPM_LIMIT=10
WEATHER_RPM_LIMIT=30
# Optional: when set, /api/chat requires header X-API-Key
API_KEY=
CHAT_MAX_MESSAGE_CHARS=2000
TELEMETRY_CACHE_TTL=300
