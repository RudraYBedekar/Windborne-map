# WindBorne API
WB_API_KEY=your_windborne_api_key
WINDBORNE_BASE_URL=https://api.windbornesystems.com

# ----------------------------------------------------
# Vicky-AI — Amazon Bedrock (single source of truth)
# ----------------------------------------------------
BEDROCK_ENABLED=true
AWS_REGION=us-east-1

# Prefer these (matches production .env). Do NOT use NVIDIA / Nemotron IDs.
BEDROCK_AGENT_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_LLM_MODEL=us.amazon.nova-2-lite-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# Optional branding overrides (otherwise derived from model ID)
AI_PROVIDER=Amazon Bedrock
# AI_MODEL_DISPLAY_NAME=Claude Haiku 4.5

# Balloon markers on the website (default off — Treasure feed not operationally accurate)
BALLOONS_ENABLED=false

# AWS credentials (leave empty on EC2 IAM role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
