# WindBorne Weather API
WB_API_KEY=your_windborne_api_key
WINDBORNE_BASE_URL=https://api.windbornesystems.com

# Show balloon markers (default off)
NEXT_PUBLIC_SHOW_BALLOONS=false

# OpenWeather overlays: set public key OR enable + keep key only in backend/.env
# NEXT_PUBLIC_OPENWEATHER_KEY=
NEXT_PUBLIC_OPENWEATHER_ENABLED=true

# Optional map keys
# NEXT_PUBLIC_MAPTILER_KEY=
